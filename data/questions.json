  "passages": [
    {
      "id": "p6-1",
      "part": 6,
      "title": "Internal Memo — Health and Safety Training",
      "documents": [
        {
          "id": "p6-1-d1",
          "kind": "memo",
          "title": "To: All Staff",
          "body": [
            "From: Human Resources Department",
            "Subject: Annual Health and Safety Training",
            "We would like to inform you that the annual health and safety training will take place next month. All employees must attend one of the two sessions (1)______ in the main auditorium.",
            "The training (2)______ a presentation on fire safety, followed by a hands-on demonstration. Participants are encouraged to (3)______ questions at the end of each session.",
            "Please note that sessions are limited to forty people. We therefore recommend that you (4)______ as soon as possible to secure your place."
          ]
        }
      ]
    },
    {
      "id": "p6-2",
      "part": 6,
      "title": "Article — Opening of a Distribution Center",
      "documents": [
        {
          "id": "p6-2-d1",
          "kind": "article",
          "title": "Global Foods Announces Major Expansion",
          "body": [
            "Global Foods Inc. announced yesterday that it (1)______ a new distribution center in southern France next spring. The facility, which is expected to create more than 200 jobs, will be the largest in the company's European network.",
            "According to the chief executive officer, the decision was made (2)______ growing demand in the region. \"Our sales in France have doubled over the past three years,\" she said, \"and this investment will allow us to serve our customers more (3)______.\"",
            "Construction is due to begin in April and (4)______ by the end of next year."
          ]
        }
      ]
    },
    {
      "id": "p7-1",
      "part": 7,
      "title": "Email — Flight Schedule Change",
      "documents": [
        {
          "id": "p7-1-d1",
          "kind": "email",
          "title": "To: Marie Dubois",
          "body": [
            "From: Horizon Travel",
            "Subject: Change to Your Flight Schedule",
            "Dear Ms. Dubois,",
            "We are writing to inform you of a change to your upcoming flight to London. Due to a schedule adjustment by the airline, your March 12 departure has been moved from 9:15 a.m. to 11:40 a.m.",
            "As a result, you will arrive at Heathrow Airport at 1:05 p.m. (local time), approximately two hours later than originally planned. We apologize for any inconvenience this may cause.",
            "If the new schedule does not suit you, please contact our office within 24 hours and we will arrange a replacement flight at no additional cost. Otherwise, no action is required and your booking will be updated automatically.",
            "Thank you for your understanding.",
            "Sincerely,",
            "Horizon Travel Customer Service"
          ]
        }
      ]
    },
    {
      "id": "p7-2",
      "part": 7,
      "title": "Email + Schedule — Annual Conference",
      "documents": [
        {
          "id": "p7-2-d1",
          "kind": "email",
          "title": "To: All Employees",
          "body": [
            "From: James Carter, Events Manager",
            "Subject: Annual Conference",
            "I am pleased to announce that the annual conference will be held at the City Convention Center from June 10 to 12. All employees are invited to attend the keynote speech on the first day. Please review the attached schedule and register for the workshops of your choice by May 25."
          ]
        },
        {
          "id": "p7-2-d2",
          "kind": "schedule",
          "title": "Schedule — Day 1 (June 10)",
          "body": [
            "9:00 – 10:00: Registration and coffee",
            "10:00 – 11:30: Keynote speech: \"The Future of Work\"",
            "11:30 – 1:00: Lunch (sponsored by TechNova)",
            "1:00 – 3:00: Workshop A: Leadership Skills",
            "3:00 – 5:00: Workshop B: Digital Marketing",
            "5:00 – 6:00: Networking reception"
          ]
        }
      ]
    },
    {
      "id": "p7-3",
      "part": 7,
      "title": "Complaint + Return Policy + Reply",
      "documents": [
        {
          "id": "p7-3-d1",
          "kind": "email",
          "title": "To: Customer Service",
          "body": [
            "From: Luc Moreau",
            "Subject: Refund Request — Order No. 4821",
            "Hello,",
            "I ordered a laptop stand from your website on March 3, and it arrived damaged. I tried to reach you by phone, but nobody answered. I would like a full refund or a replacement as soon as possible. Please let me know what steps to follow.",
            "Sincerely,",
            "Luc Moreau"
          ]
        },
        {
          "id": "p7-3-d2",
          "kind": "notice",
          "title": "Return Policy",
          "body": [
            "Customers may return any item within 30 days of delivery. Items that arrive damaged may be returned for a full refund or replaced free of charge. To start a return, the customer must complete the online form on our website and attach a photo of the damaged item. Refunds are processed within 5 business days of receiving the returned item."
          ]
        },
        {
          "id": "p7-3-d3",
          "kind": "email",
          "title": "To: Luc Moreau",
          "body": [
            "From: Amélie Bernard, Customer Service",
            "Subject: Re: Refund Request — Order No. 4821",
            "Dear Mr. Moreau,",
            "Thank you for contacting us. We sincerely apologize for the damaged item and for our delayed response. Please complete the online return form and attach a photo of the stand. Once we receive the item, we will issue a full refund within 5 business days. As a gesture of apology, we have also added a 10% discount to your account for your next purchase.",
            "Sincerely,",
            "Amélie Bernard"
          ]
        }
      ]
    }
  ],
