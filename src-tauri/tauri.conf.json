{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lernoviq",
  "identifier": "com.teamfliyou.lernoviq",
  "build": {
    "beforeBuildCommand": "dx build --release --platform web --package lernoviq-ui",
    "frontendDist": "../target/dx/lernoviq-ui/release/web/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lernoviq — Coach TOEIC",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["French"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RDFERDJDNDE1RUE3NEIKUldSTHAxNUJMTjNSaFQ2UDJ6TUVMVldNMVFVOFFrVXZNWWdnY1ZvUGhXVWRsUnFkOHVDRyt6MHEK",
      "endpoints": ["https://github.com/Teamfliyou/toeic-reading-ai-coach/releases/latest/download/latest.json"]
    }
  }
}
