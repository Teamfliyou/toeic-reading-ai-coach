# --- DeepSeek (obligatoire pour les explications IA) ---
# Clé API obtenue sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Modèle actuel : deepseek-flash (deepseek-chat a été retiré le 2026-07-24).
DEEPSEEK_MODEL=deepseek-flash
# "true" réactive le mode « thinking » : coût des tokens de raisonnement en plus.
DEEPSEEK_THINKING_ENABLED=false
# Plafonds de sécurité par appel (coût et latence).
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT_MS=22000

# --- Supabase (optionnel, voir README) ---
# Non requis pour tester : les questions proviennent de data/questions.json.
SUPABASE_URL=
# Clé publique : vérification des jetons Supabase Auth côté serveur.
SUPABASE_ANON_KEY=
# Clé service_role : persistance des explications, quotas et budget.
# Serveur uniquement. Ne jamais préfixer par VITE_ ni exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Port du serveur de production (optionnel) ---
PORT=3000

# --- Protection de /api/explain (optionnel) ---
# Débit par IP pour les appels ANONYMES (clé serveur) : 60 / 10 min.
EXPLAIN_RATE_LIMIT=60
EXPLAIN_RATE_WINDOW_MS=600000
# Refuse les requêtes navigateur d'une origine différente (proxy ouvert).
EXPLAIN_RESTRICT_ORIGIN=true
# "false" pour exiger une clé DeepSeek personnelle côté client et ne plus jamais
# consommer la clé du serveur via /api/explain.
ALLOW_SERVER_KEY_FALLBACK=true

# --- Quotas et budget des explications gratuites (clé serveur) ---
# Quota quotidien par UTILISATEUR CONNECTÉ (Supabase Auth).
AI_DAILY_LIMIT=10
# Débit par minute et par utilisateur connecté.
AI_PER_MINUTE=3
AI_PER_MINUTE_WINDOW_MS=60000
# Budget mensuel : suspension à 8 € puis arrêt à 10 € (DeepSeek facture en USD).
AI_MONTHLY_LIMIT_EUR=10
AI_MONTHLY_SUSPEND_EUR=8
AI_USD_EUR_RATE=0.93
# Réservation a priori par appel (majorée pour ne jamais dépasser le budget).
AI_ESTIMATED_CALL_USD=0.002
# "true" pour n'accorder l'explication gratuite qu'aux utilisateurs connectés.
AI_FREE_REQUIRES_AUTH=false

# --- Administration privée ---
# Compte initial créé à la première connexion si la table est vide. Pas de mot de passe codé en dur.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères ; différente du mot de passe.
ADMIN_SESSION_SECRET=
