# --- DeepSeek (obligatoire pour les explications IA) ---
# Clé API obtenue sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Modèle actuel : deepseek-flash (deepseek-chat a été retiré le 2026-07-24).
DEEPSEEK_MODEL=deepseek-flash
# "true" réactive le mode « thinking » : coût des tokens de raisonnement en plus.
DEEPSEEK_THINKING_ENABLED=false
# Plafonds de sécurité par appel (coût et latence).
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT_MS=22000

# --- Supabase (optionnel, voir README) ---
# Non requis pour tester : les questions proviennent de data/questions.json.
SUPABASE_URL=
# Clé publique : vérification des jetons Supabase Auth côté serveur.
SUPABASE_ANON_KEY=
# Clé service_role : persistance des explications, quotas et budget.
# Serveur uniquement. Ne jamais préfixer par VITE_ ni exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Port du serveur de production (optionnel) ---
PORT=3000

# --- Protection de /api/explain (optionnel) ---
# Débit par IP pour les appels ANONYMES (clé serveur) : 60 / 10 min.
EXPLAIN_RATE_LIMIT=60
EXPLAIN_RATE_WINDOW_MS=600000
# Refuse les requêtes navigateur d'une origine différente (proxy ouvert).
EXPLAIN_RESTRICT_ORIGIN=true
# "false" pour exiger une clé DeepSeek personnelle côté client et ne plus jamais
# consommer la clé du serveur via /api/explain.
ALLOW_SERVER_KEY_FALLBACK=true

# --- Quotas et budget des explications gratuites (clé serveur) ---
# Quota quotidien par UTILISATEUR CONNECTÉ (Supabase Auth).
AI_DAILY_LIMIT=10
# Visiteurs NON connectés : quota par IP (appliqué en base, partagé entre instances).
AI_ANON_DAILY_LIMIT=5
AI_ANON_PER_MINUTE=2
# Débit par minute et par utilisateur connecté.
AI_PER_MINUTE=3
AI_PER_MINUTE_WINDOW_MS=60000
# Budget mensuel : suspension à 8 € puis arrêt à 10 € (DeepSeek facture en USD).
AI_MONTHLY_LIMIT_EUR=10
AI_MONTHLY_SUSPEND_EUR=8
# ATTENTION : taux FIXE (1 USD = 0,93 EUR). Le change évolue : mettez-le à jour,
# sinon le budget en euros sera mal converti. Un avertissement s'affiche au
# démarrage tant que la variable est absente.
AI_USD_EUR_RATE=0.93
# Réservation a priori par appel (majorée pour ne jamais dépasser le budget).
AI_ESTIMATED_CALL_USD=0.004
# Réservation a priori d'une génération de questions (admin) et plafond horaire.
AI_ESTIMATED_GENERATION_USD=0.012
# Réservation a priori d'une question de relance au coach (réponse courte).
AI_ESTIMATED_FOLLOWUP_USD=0.002
ADMIN_GENERATE_PER_HOUR=10
# "true" pour n'accorder l'explication gratuite qu'aux utilisateurs connectés.
# RECOMMANDÉ EN PRODUCTION (sinon seule l'IP limite les visiteurs anonymes).
AI_FREE_REQUIRES_AUTH=false

# --- Adresse IP du client ---
# "true" uniquement derrière un reverse proxy de confiance (x-forwarded-for lu).
# Détecté automatiquement sur Vercel. Laisser vide en accès direct.
TRUST_PROXY=

# --- Administration privée ---
# ADMIN_INITIAL_PASSWORD est un CODE DE CONFIGURATION privé (16 caractères minimum),
# demandé à la création du premier compte admin ; ce n'est pas le mot de passe du compte.
ADMIN_INITIAL_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères ; différente du mot de passe.
ADMIN_SESSION_SECRET=

# Limitation distribuée de la connexion admin (nécessite supabase/ai_hardening.sql).
ADMIN_LOGIN_MAX_PER_IP=20
ADMIN_LOGIN_MAX_PER_USER=8
ADMIN_LOGIN_WINDOW_SECONDS=900

# --- Mesure d'audience (Plausible), facultative ---
# Vide = aucune mesure. Sans cookie ni donnée personnelle ; « Do Not Track » respecté.
# Variables publiques (incluses dans le build) : ne jamais y mettre de secret.
# Renseignez votre domaine tel que déclaré dans Plausible, puis reconstruisez l'application.
VITE_PLAUSIBLE_DOMAIN=
# Script à charger (défaut : plausible.io, version compatible avec le routage par #).
# Pour un Plausible auto-hébergé, ajoutez son domaine à la CSP (server/security-headers.mjs et vercel.json).
VITE_PLAUSIBLE_SRC=
