# --- DeepSeek (obligatoire pour les explications IA) ---
# Clé API obtenue sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Supabase (optionnel, voir README) ---
# Non requis pour tester : les questions proviennent de data/questions.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Port du serveur de production (optionnel) ---
PORT=3000

# --- Administration privée ---
# Compte initial créé à la première connexion si la table est vide. Pas de mot de passe codé en dur.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères ; différente du mot de passe.
ADMIN_SESSION_SECRET=

# Facultatif : validation et publication vers la bibliothèque Supabase
SUPABASE_SERVICE_ROLE_KEY=
